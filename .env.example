# Local infrastructure only. Copy to .env at the repository root.
# These credentials are for loopback-bound development containers, never production.
DATABASE_URL=postgresql://hotel_dev:hotel_dev@127.0.0.1:54329/hotel_platform?schema=public
REDIS_URL=redis://localhost:63799
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Explicit read-only fictional inventory for local UI development, never production.
# `pnpm db:prepare:mock` deploys migrations and seeds dedicated mock tables locally.
# `pnpm dev:mock` selects mock; PostgreSQL is required, Redis is not used.
# Mock mode reads the database and mounts hotel reads only; bookings/payments are disabled.
HOTEL_DATA_MODE=live

# Backend session verification. Obtain from your Clerk dashboard; leave empty for public-only development.
CLERK_SECRET_KEY=
# Optional networkless verification public key, instead of Clerk secret.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Account-specific HTTPS REST endpoint and credentials provided by TBO.
# The base URL cannot contain embedded credentials, a query string or a fragment.
# v2.1 Search/HotelDetails/PreBook reads have synthetic contract fixtures, not account certification.
# Read apps/api/src/modules/tbo/INTEGRATION.md and validate account fixtures before enabling reads.
# Book, BookingDetail and Cancel remain disabled regardless of this flag.
TBO_BASE_URL=
TBO_USERNAME=
TBO_PASSWORD=
TBO_READS_ENABLED=false
TBO_TIMEOUT_MS=30000
TBO_MAX_RETRIES=2

# Currently only the disabled payment adapter is implemented. No card data is accepted.
PAYMENT_PROVIDER=disabled
# Add provider-specific credentials only when implementing a real gateway adapter.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
JOBS_ENABLED=false
MARKUP_BASIS_POINTS=1000
QUOTE_TTL_SECONDS=300
MAX_STAY_NIGHTS=30

# Explicit integration-test database; tests refuse ordinary application database names.
TEST_DATABASE_URL=postgresql://hotel_dev:hotel_dev@127.0.0.1:54329/hotel_platform_test?schema=public

# Next.js uses apps/web/.env.local. See apps/web/.env.example.
