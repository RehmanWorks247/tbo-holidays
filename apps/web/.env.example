# Public API URL must end with the versioned API prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Keep this aligned with API MAX_STAY_NIGHTS (1-90).
NEXT_PUBLIC_MAX_STAY_NIGHTS=30

# Add both Clerk keys from the same Clerk application to enable sign-in.
# Empty keys leave public pages available and deny access to protected pages.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
