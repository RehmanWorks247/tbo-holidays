# Local infrastructure only. Copy to .env at the repository root.
# These credentials are for loopback-bound development containers, never production.
DATABASE_URL=postgresql://hotel_dev:hotel_dev@localhost:54329/hotel_platform?schema=public
REDIS_URL=redis://localhost:63799
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Backend session verification. Obtain from your Clerk dashboard; leave empty for public-only development.
CLERK_SECRET_KEY=
# Optional networkless verification public key, instead of Clerk secret.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Account-specific HTTPS REST endpoint and credentials provided by TBO.
# Read INTEGRATION.md in the TBO module before explicitly enabling candidate REST reads.
TBO_BASE_URL=
TBO_USERNAME=
TBO_PASSWORD=
TBO_READS_ENABLED=false
TBO_TIMEOUT_MS=30000
TBO_MAX_RETRIES=2

# Currently only the disabled payment adapter is implemented. No card data is accepted.
PAYMENT_PROVIDER=disabled
# Add provider-specific credentials only when implementing a real gateway adapter.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
JOBS_ENABLED=false
MARKUP_BASIS_POINTS=1000
QUOTE_TTL_SECONDS=300
MAX_STAY_NIGHTS=30

# Explicit integration-test database; tests refuse ordinary application database names.
TEST_DATABASE_URL=postgresql://hotel_dev:hotel_dev@localhost:54329/hotel_platform_test?schema=public

# Next.js uses apps/web/.env.local. See apps/web/.env.example.
