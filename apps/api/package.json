{
  "name": "@hotel/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "db:test:deploy": "dotenv -e ../../.env -- node scripts/migrate-test-database.mts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@hotel/contracts": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.61.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "nestjs-pino": "^4.4.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hotel/eslint-config": "workspace:*",
    "@hotel/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "1.13.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.0"
  }
}
